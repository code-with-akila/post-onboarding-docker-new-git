{
  "family": "post-onboarding-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::738408430142:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "post-onboarding-container",
      "image": "738408430142.dkr.ecr.us-east-1.amazonaws.com/post-onboarding-docker:latest",
      "portMappings": [
        {
          "containerPort": 5000,
          "protocol": "tcp"
        }
      ],
      "essential": true
    }
  ]
}

